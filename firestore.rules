rules_version = '2';

// ============================================================================
// NEXVION AI — Production Firestore Security Rules (Phase 11 Hardened)
// ============================================================================
// Security Architecture:
//  - Multi-tier role verification: Owner, Super Admin, Content Manager,
//    Student Manager, Analyst.
//  - Never trusts role parameters sent by browser request payloads;
//    evaluates directly against /adminUsers/{uid} document on the server.
//  - Strict 30-student batch capacity invariant enforced in rules.
//  - Append-only immutable audit trail.
//  - Public read for active courses & tiers to power discovery & registration.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper Functions & Role Verification (Server-Side)
    // -----------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAdminDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    // Server-verified role check (never relies on client request body)
    function getAdminRole() {
      return hasAdminDoc() ? getAdminDoc().role : (isAuthenticated() && request.auth.token.role != null ? request.auth.token.role : 'None');
    }

    function isOwner() {
      return isAuthenticated() && (getAdminRole() == 'Owner' || (hasAdminDoc() && getAdminDoc().isOwner == true));
    }

    function isSuperAdmin() {
      return isAuthenticated() && (isOwner() || getAdminRole() == 'Super Admin');
    }

    function isContentManager() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'Content Manager');
    }

    function isStudentManager() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'Student Manager');
    }

    function isFinanceManager() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'Finance Manager');
    }

    function isAnalyst() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'Analyst' || isContentManager() || isStudentManager());
    }

    function isAcademicDirector() {
      return isAuthenticated() && (isSuperAdmin() || getAdminRole() == 'Academic Director' || getAdminRole() == 'Certifier');
    }

    function hasField(data, field) {
      return field in data;
    }

    // Invariant: Max capacity is strictly 30 per cohort
    function batchCapacityValid() {
      return (!hasField(request.resource.data, 'capacity') || request.resource.data.capacity <= 30)
          && (!hasField(request.resource.data, 'enrolledCount') || request.resource.data.enrolledCount <= 30);
    }

    // -----------------------------------------------------------------------
    // Default Deny All
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Admin Users  (/adminUsers/{userId})
    // -----------------------------------------------------------------------
    match /adminUsers/{userId} {
      // Authenticated admins can view admin profiles; a user can read their own profile
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAnalyst());
      // Only Super Admin or Owner can provision or modify admin accounts
      allow create, update: if isSuperAdmin();
      // Client-side hard deletes are strictly forbidden; status must be set to 'Suspended'
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Roles & Permissions  (/roles/{roleId})
    // -----------------------------------------------------------------------
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Audit Logs  (/auditLogs/{logId})
    // -----------------------------------------------------------------------
    // Audit logs are append-only. Mutation or deletion is strictly blocked.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isOwner() || isAnalyst();
      allow create: if isAuthenticated()
                    && hasField(request.resource.data, 'action')
                    && hasField(request.resource.data, 'timestamp');
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Platform Settings  (/settings/{settingId})
    // -----------------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // -----------------------------------------------------------------------
    // Courses  (/courses/{courseId})
    // -----------------------------------------------------------------------
    match /courses/{courseId} {
      // Public read for public catalogue; full catalogue read for authenticated staff
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;

      match /{subCollection}/{docId} {
        allow read: if true;
        allow write: if isContentManager();
      }
    }

    // -----------------------------------------------------------------------
    // Tiers  (/tiers/{tierId})
    // -----------------------------------------------------------------------
    match /tiers/{tierId} {
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Batches  (/batches/{batchId})
    // -----------------------------------------------------------------------
    // Server-enforced 30-student cohort hard limit
    match /batches/{batchId} {
      allow read: if true;
      allow create, update: if isStudentManager() && batchCapacityValid();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Students  (/students/{studentId})
    // -----------------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isStudentManager() || isAnalyst() || (isAuthenticated() && request.auth.uid == studentId);
      allow create, update: if isStudentManager() || (isAuthenticated() && request.auth.uid == studentId);
      allow delete: if false;

      match /notes/{noteId} {
        allow read: if isStudentManager();
        allow create: if isStudentManager()
                      && hasField(request.resource.data, 'text')
                      && hasField(request.resource.data, 'author');
        allow update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Enrollments  (/enrollments/{enrollmentId})
    // -----------------------------------------------------------------------
    match /enrollments/{enrollmentId} {
      // Student managers and analysts can read; individual student can read their own
      allow read: if isStudentManager() || isAnalyst() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      // Students or admissions can submit new enrollment applications
      allow create: if (isAuthenticated() || hasField(request.resource.data, 'studentEmail'))
                    && hasField(request.resource.data, 'courseId');
      // Only Student Manager can update status (Approve, Reject, Waitlist, Assign Batch)
      allow update: if isStudentManager();
      // Historical enrollments must never be silently deleted
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Content Hierarchy: Modules, Classes, Lessons, Videos, Resources
    // -----------------------------------------------------------------------
    match /modules/{moduleId} {
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Assessment: Projects, Assignments, Submissions
    // -----------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isContentManager();
      allow delete: if false;
    }

    match /submissions/{submissionId} {
      allow read: if isStudentManager() || isContentManager() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isStudentManager() || isContentManager() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow delete: if false;
    }

    match /fileMetadata/{fileId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isContentManager() || isSuperAdmin();
    }

    // -----------------------------------------------------------------------
    // Announcements & Notifications
    // -----------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isContentManager() || isStudentManager();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create, update: if isStudentManager() || isSuperAdmin();
      allow delete: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /notificationPreferences/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStudentManager());
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /userInboxes/{userId}/messages/{messageId} {
      allow read, update: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Payments (Tuition & Billing Records)
    // -----------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isFinanceManager() || (isAuthenticated() && getAdminRole() == 'Analyst');
      allow create, update: if isFinanceManager();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Certificates (Phase 15: Secure Eligibility & Issuance)
    // -----------------------------------------------------------------------
    match /certificates/{certificateId} {
      allow read: if isStudentManager() || isAcademicDirector() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create, update: if isSuperAdmin() || isAcademicDirector();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Support Tickets (Phase 16: Backend Support Operations)
    // -----------------------------------------------------------------------
    match /supportTickets/{ticketId} {
      allow read: if isStudentManager() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() || isStudentManager();
      allow update: if isStudentManager() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if isStudentManager() || (isAuthenticated() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.studentId == request.auth.uid);
        allow create: if isAuthenticated() || isStudentManager();
        allow update, delete: if false;
      }

      match /internalNotes/{noteId} {
        allow read, write: if isStudentManager();
      }
    }

    // -----------------------------------------------------------------------
    // Analytics (Phase 16: Operations & Educational Telemetry)
    // -----------------------------------------------------------------------
    match /analytics/{docId} {
      allow read: if isAnalyst();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

  }
}
