# ============================================================================
# NEXVION AI — Environment Configuration Reference
# ============================================================================
# This file documents all configuration variables used by the NEXVION AI
# admin portal. Do NOT commit actual secrets.
#
# For local development, values are embedded directly in firebase-config.js
# and admin-auth.js. For CI/CD pipelines, inject these as build environment
# variables and substitute at build time.
# ============================================================================

# Firebase Project
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# What NOT to commit
# ============================================================================
# - Firebase service account JSON files (*serviceAccount*.json)
# - Admin SDK private keys
# - Production database dumps
# - Real student PII (Personally Identifiable Information)
# - Payment processor keys or secrets
# ============================================================================
